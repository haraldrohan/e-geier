<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>EGeier.Net</AssemblyName>
    <RootNamespace>EGeier</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EGeier.Net</PackageId>
    <Title>E-Geier</Title>
    <Description>E-Geier: .NET-Client für die öffentlichen APIs der E-Control Austria (Spritpreisrechner) inklusive Geocoding über OpenStreetMap Nominatim. Inoffiziell, nicht mit der E-Control Austria verbunden. / .NET client for the public APIs of E-Control Austria (fuel price calculator). Unofficial, not affiliated with E-Control Austria.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EGeier.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
