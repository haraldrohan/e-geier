<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EGeier.Mcp</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>EGeier.Mcp</PackageId>
    <Title>E-Geier MCP-Server</Title>
    <Description>E-Geier: lokaler MCP-Server (stdio) für die öffentliche Spritpreisrechner-API der E-Control Austria – findet die günstigsten Tankstellen in Österreich. Inoffiziell, nicht mit der E-Control Austria verbunden. / Local MCP server for the public fuel price API of E-Control Austria. Unofficial, not affiliated with E-Control Austria.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>e-geier-mcp</ToolCommandName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EGeier\EGeier.csproj" />
    <InternalsVisibleTo Include="EGeier.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
