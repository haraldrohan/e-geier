<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EGeier.Mcp</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ContainerRepository>haraldrohan/e-geier</ContainerRepository>
    <!-- Small, non-root image that still has ICU and tzdata (Europe/Vienna time, umlauts). -->
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
    <ContainerImageTags>latest</ContainerImageTags>
  </PropertyGroup>

  <ItemGroup>
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/haraldrohan/e-geier" />
    <ContainerLabel Include="org.opencontainers.image.description" Value="E-Geier remote MCP server for Austrian fuel prices. Unofficial, not affiliated with E-Control Austria." />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="MIT" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EGeier\EGeier.csproj" />
    <!-- The tools are shared with the stdio server. -->
    <Compile Include="..\EGeier.Mcp\SpritTools.cs" Link="SpritTools.cs" />
    <Compile Include="..\EGeier.Mcp\RegionDirectory.cs" Link="RegionDirectory.cs" />
  </ItemGroup>

</Project>
